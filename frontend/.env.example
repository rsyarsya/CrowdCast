# Copy to .env.local. NEXT_PUBLIC_* values are public; never put secrets here.

# CrowdCast backend origin (FastAPI). The dashboard calls ${NEXT_PUBLIC_API_BASE_URL}/api/v1.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Camera shown on the dashboard.
NEXT_PUBLIC_DEFAULT_CAMERA_ID="CAM-01"

# "api" reads the backend (default); "mock" serves local simulation data without a backend.
NEXT_PUBLIC_MONITORING_SOURCE="api"
