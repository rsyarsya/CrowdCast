# Copy to deploy/.env on the server. Never commit deploy/.env.

# Public host name of the API. Its DNS A record must point to this VM.
API_DOMAIN="api.crowdcast.example.ac.id"

# Generate each secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use hex for POSTGRES_PASSWORD so it is safe inside the database URL.
POSTGRES_PASSWORD="REPLACE_WITH_GENERATED_SECRET"
SECRET_KEY="REPLACE_WITH_GENERATED_SECRET"
WORKER_API_KEY="REPLACE_WITH_GENERATED_SECRET"

# Origin of the deployed frontend, JSON list or comma-separated.
BACKEND_CORS_ORIGINS="https://crowdcast.example.ac.id"

# First administrator, created by: docker compose exec api python -m app.scripts.seed --admin-only
FIRST_SUPERUSER_EMAIL="REPLACE_ADMIN_EMAIL"
FIRST_SUPERUSER_PASSWORD="REPLACE_ADMIN_PASSWORD"
