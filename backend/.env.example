# Future feature configuration; the Week 5 app does not load this file.
# PostgreSQL local target; driver and migrations are added when DB work starts.
DATABASE_URL="postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/crowdcast"

# Future authentication only. Generate secrets before enabling auth.
SECRET_KEY="REPLACE_WITH_GENERATED_SECRET"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FIRST_SUPERUSER_EMAIL="REPLACE_ADMIN_EMAIL"
FIRST_SUPERUSER_PASSWORD="REPLACE_ADMIN_PASSWORD"

# Future frontend integration and AI; not active in the minimal app.
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
# Candidate only; final model follows video/hardware evaluation.
DEFAULT_YOLO_MODEL="yolov8n.pt"
DEVICE=""
VIDEO_SAMPLE_PATH="REPLACE_WITH_LOCAL_VIDEO_PATH"
