# Copy to .env for local development. Never commit .env.

# Async PostgreSQL URL (asyncpg driver). Matches docker-compose.yml at the repo root.
DATABASE_URL="postgresql+asyncpg://crowdcast:crowdcast@localhost:5433/crowdcast"

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="REPLACE_WITH_GENERATED_SECRET"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial administrator, used by the seed script.
FIRST_SUPERUSER_EMAIL="REPLACE_ADMIN_EMAIL"
FIRST_SUPERUSER_PASSWORD="REPLACE_ADMIN_PASSWORD"

# Frontend origins allowed by CORS: JSON list or comma-separated.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Vision worker. The API and `python -m app.worker` must use the same key.
# Leave empty to disable the ingest endpoints. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_API_KEY=""
LIVE_STALE_SECONDS=15
# Video file used by the seed script for the simulated demo camera.
VIDEO_SAMPLE_PATH="data/videos/sample.mp4"
